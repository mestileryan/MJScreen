# Identifiants client OAuth publics (flux sans secret), un par cloud. Copier ce
# fichier en .env.local et renseigner les valeurs : .env.local n'est pas versionné.
# Un cloud sans identifiant reste grisé dans l'interface.
# Adresse de retour à déclarer chez chaque service (voir README) :
#   https://mestileryan.github.io/MJScreen/trackslibrary/
#   http://localhost:3200/MJScreen/trackslibrary/
NEXT_PUBLIC_DROPBOX_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=

# true : remplace les trois clouds par un cloud simulé en mémoire (développement).
NEXT_PUBLIC_CLOUD_MOCK=false
